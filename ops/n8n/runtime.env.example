# Marketing Scout — n8n runtime environment (EXAMPLE; copy to your own .env, never commit real values).
# These are NON-secret runtime knobs. Real credentials (Google Sheets, Telegram bot token, Claude/Apify keys)
# live ONLY in the n8n credential store — never in env files, never in workflow JSON. `scripts/deploy_n8n.sh
# --check-config` validates everything below; activation is blocked (fail closed) if a required value is wrong.

# --- REQUIRED ------------------------------------------------------------------------------------------------
# Google Sheets spreadsheet id that holds all Marketing Scout tabs (an id, not a secret).
MS_SPREADSHEET_ID=replace-with-your-spreadsheet-id

# Comma-separated numeric Telegram user ids allowed to talk to the agent (authorization allowlist).
MS_TELEGRAM_ALLOWED_USER_IDS=11111111,22222222

# REQUIRED for any XLSX-capable workflow (WF24 report export, WF25 weekly digest). The XLSX writer Code node
# uses Node's built-in zlib to deflate the .xlsx; n8n's Code sandbox blocks built-ins unless allow-listed.
# Activation of WF24/WF25-dependent flows is BLOCKED unless zlib is allowed here. "*" also works but is broad.
NODE_FUNCTION_ALLOW_BUILTIN=zlib

# --- FEATURE FLAGS (boolean: true/false) ---------------------------------------------------------------------
# Activate the scheduled source monitor (WF23). Off by default.
MS_MONITORING_ENABLED=false
# Activate the weekly digest (WF25, XLSX-capable → needs zlib). Off by default.
MS_WEEKLY_DIGEST_ENABLED=false
# Allow guarded Claude calls in planning / summarization. Off by default (deterministic, $0).
MS_ENABLE_LLM_PLANNER=false
MS_ENABLE_LLM_SUMMARY=false
# Require human approval before any paid/external work, and require source-health before collection.
MS_REQUIRE_APPROVAL=true
MS_REQUIRE_SOURCE_HEALTH=true

# --- BUDGETS / LIMITS (non-negative numbers; blank → safe defaults in n8n/lib/agent_config.js) ---------------
MS_MAX_SOURCES=3
MS_MAX_ITEMS_PER_SOURCE=25
MS_MAX_EXTERNAL_CALLS=40
MS_SOURCE_BUDGET_USD=0.20
MS_LLM_BUDGET_USD=0.50

# --- SCOPE ----------------------------------------------------------------------------------------------------
# Allowed source types (subset of: website vk telegram avito reviews forum classifieds social).
MS_SOURCE_ALLOWLIST=website
MS_DEFAULT_REGION=Москва/МО
MS_DEFAULT_NICHE=credit_brokerage

# --- VERSION PINNING (optional) -------------------------------------------------------------------------------
# Set to true ONLY if you knowingly run a floating tag (e.g. :latest). scripts/check_n8n_runtime.sh treats a
# floating tag as unsafe unless this is true. Production should pin n8nio/n8n:2.23.3 (see N8N_VERSION_PINNING.md).
MS_ALLOW_FLOATING_N8N_IMAGE=false

# --- SECRETS DO NOT GO HERE -----------------------------------------------------------------------------------
# MS_TELEGRAM_BOT_TOKEN, Google service-account JSON, CLAUDE/Anthropic key, Apify token, Firecrawl key, VK
# access token → n8n credential store only. They are referenced by workflows via the credential store, never env.
