{
  "$schema_note": "Machine-readable Google Sheets contract for Marketing Scout. Single source of truth for tab names, scope columns, retention class and protections. tools/validate_sheet_contracts.js asserts every workflow Sheets node targets a declared tab; n8n/lib/sheet_audit.js validates row content at runtime; n8n/lib/retention_policy.js enforces retention + protections. Offline, no secrets.",
  "version": "contracts-v1",
  "scope_columns": [
    "owner_user_id",
    "agent_request_id",
    "report_id"
  ],
  "retention_classes": {
    "permanent": "never auto-deleted (audit trail)",
    "durable": "never auto-deleted (user preferences / current baselines)",
    "operational": "request work product; eligible after retention_days unless its request is active or its report is retained",
    "report": "user-facing reports + report data; recent reports protected",
    "conversation": "chat memory; eligible after retention_days",
    "outbox": "delivery queue; unsent entries are protected"
  },
  "dynamic_tab_allowlist": [
    "={{ $json.route }}",
    "results"
  ],
  "tabs": {
