# n8n.env.example
# Copy this file to your deployment directory and rename it to n8n.env.
# Fill in real values before starting n8n. Do NOT commit n8n.env to Git.
#
# Generate N8N_ENCRYPTION_KEY with:
#   openssl rand -hex 32

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Required: used to encrypt credentials stored by n8n.
# Generate once and keep it safe — changing it invalidates all stored credentials.
N8N_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# ------------------------------------------------------------
# Network
# ------------------------------------------------------------

# Bind n8n to localhost only (SSH tunnel access).
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Set to false when running over HTTP (no HTTPS/domain in v0.1).
N8N_SECURE_COOKIE=false

# ------------------------------------------------------------
# Timezone
# ------------------------------------------------------------

GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# ------------------------------------------------------------
# Telemetry and onboarding (disabled for privacy and clean setup)
# ------------------------------------------------------------

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
