# n8n.env.example
# Copy this file to your deployment directory and rename it to n8n.env.
# Fill in real values before starting n8n. Do NOT commit n8n.env to Git.
#
# Generate N8N_ENCRYPTION_KEY with:
#   openssl rand -hex 32

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Required: used to encrypt credentials stored by n8n.
# Generate once and keep it safe — changing it invalidates all stored credentials.
N8N_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# ------------------------------------------------------------
# Network
# ------------------------------------------------------------

# Bind n8n to localhost only (SSH tunnel access).
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Set to false when running over HTTP (no HTTPS/domain in v0.1).
N8N_SECURE_COOKIE=false

# ------------------------------------------------------------
# Timezone
# ------------------------------------------------------------

GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# ------------------------------------------------------------
# Telemetry and onboarding (disabled for privacy and clean setup)
# ------------------------------------------------------------

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# ------------------------------------------------------------
# n8n Code-node runtime (LIVE-001 / ENV-001)
# ------------------------------------------------------------

# REQUIRED: Code nodes read $env at runtime; this MUST be false or the gateway breaks.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Allow zlib inside the XLSX-writer Code node (and nothing else).
NODE_FUNCTION_ALLOW_BUILTIN=zlib

# ------------------------------------------------------------
# Marketing Scout — explicit ZERO-PAID runtime profile (CONFIG-002/003)
# Every flag is explicit and auditable; under this profile NO paid call can fire.
# Validate with:  node tools/preflight_config.js --profile zero-paid
# ------------------------------------------------------------

MS_ENABLE_TELEGRAM=true
MS_ENABLE_EXTERNAL_ACTIONS=false
MS_ENABLE_APIFY=false
MS_ENABLE_FIRECRAWL=false
MS_ENABLE_VK=false
MS_ENABLE_CLAUDE=false
MS_ENABLE_LLM_PLANNER=false
MS_ENABLE_LLM_SUMMARY=false
MS_REQUIRE_APPROVAL=true
MS_REQUIRE_SOURCE_HEALTH=true
MS_MONITORING_ENABLED=false
MS_WEEKLY_DIGEST_ENABLED=false
MS_SOURCE_BUDGET_USD=0
MS_LLM_BUDGET_USD=0
MS_MAX_EXTERNAL_CALLS=0
MS_MAX_SOURCES=1
MS_MAX_ITEMS_PER_SOURCE=10
MS_SOURCE_ALLOWLIST=website
MS_TIMEZONE=Europe/Moscow
MS_REPORT_DATA_MODE=live

# ------------------------------------------------------------
# Operator-supplied secrets (NEVER commit real values; n8n.env is gitignored)
# ------------------------------------------------------------

# Telegram bot token (BotFather). Validated by shape only; never printed.
MS_TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Comma-separated numeric Telegram user ids allowed to use the bot.
MS_TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_NUMERIC_USER_IDS
# Google Sheets spreadsheet id (storage backend).
MS_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
# Telegram webhook secret token (openssl rand -hex 32) — validates X-Telegram-Bot-Api-Secret-Token.
MS_TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_openssl_rand_-hex_32
# Operator-provided public HTTPS ingress base url (do NOT take port 443 from sing-box).
PUBLIC_WEBHOOK_BASE_URL=https://REPLACE_WITH_YOUR_PUBLIC_HTTPS_HOST
